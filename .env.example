# Copy to .env next to docker-compose.yml. Only WALFLOW_SECRET_KEY is required.

# Signs login tokens. Generate one with:  openssl rand -hex 32
# Changing it logs every user out.
WALFLOW_SECRET_KEY=

# Cookies only travel over HTTPS by default. Set to false only for a plain-HTTP LAN install.
# WALFLOW_SECURE_COOKIES=true

# Reverse proxies that append to X-Forwarded-For in front of the backend (the bundled nginx counts as 1).
# Use 2 if another proxy (Traefik, Nginx Proxy Manager, ...) sits in front of the frontend container.
# WALFLOW_TRUSTED_PROXY_HOPS=1

# true = running simulations also needs a login (default false: anonymous users may simulate)
# WALFLOW_REQUIRE_WS_AUTH=false

# Limits for one simulation request
# WALFLOW_MAX_NODES=500
# WALFLOW_MAX_CASES=20
# WALFLOW_SOLVE_TIMEOUT_S=60
# WALFLOW_MAX_CONCURRENT_SOLVES=
# UVICORN_WS_MAX_SIZE=2097152
# NGINX_MAX_BODY_SIZE=5m
