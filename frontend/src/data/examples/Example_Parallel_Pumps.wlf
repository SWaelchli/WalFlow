      "position": {
        "x": 260,
        "y": 140
      },
      "data": {
        "label": "Duty Pump A",
        "flow_rated_lmin": 250.0,
        "pressure_rated_bar": 6.0,
        "rise_to_shutoff_pct": 20.0
      }
    },
