      },
      "data": {
        "label": "Note",
        "title": "PARALLEL PUMPING & MIN-FLOW",
        "text": "Demonstrates parallel centrifugal pump operation (Duty/Standby) discharging into a common header. Illustrates check valve backflow protection and minimum-flow bypass orifices to protect pumps from deadheading under low demand.\n\nAfter running, look at how the flow splits between the two pumps and what passes through the minimum-flow bypass. All lines run at about 3.7 m/s.",
        "fontSize": "md"
      }
    },
    {
      "id": "common-suction-tank",
      "type": "tank",
      "position": {
        "x": -50,
        "y": 250
      },
      "data": {
        "label": "Suction Storage Tank",
        "level_m": 3.0,
        "elevation_m": 0.0,
        "temperature_k": 293.15,
        "num_ports": 1
      }
    },
    {
      "id": "pump-a",
      "type": "centrifugal_pump",
      "position": {
        "x": 260,
        "y": 140
      },
      "data": {
        "label": "Duty Pump A",
        "flow_rated_lmin": 250.0,
        "head_rated_m": 61.2,
        "rise_to_shutoff_pct": 20.0
      }
    },
    {
      "id": "check-bypass-a",
      "type": "check_valve_orifice",
      "position": {
        "x": 420,
        "y": 140
      },
      "data": {
        "label": "Check Valve + Min Flow Bypass A",
        "cv": 12.0,
        "cracking_pressure_bar": 0.2,
        "orifice_diameter_m": 0.006
      }
    },
