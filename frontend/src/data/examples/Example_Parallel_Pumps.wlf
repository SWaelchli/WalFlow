      "data": {
        "label": "Note",
        "title": "PARALLEL PUMPING & MIN-FLOW",
        "text": "Demonstrates parallel centrifugal pump operation (Duty/Standby) discharging into a common header. Illustrates check valve backflow protection and minimum-flow bypass orifices to protect pumps from deadheading under low demand.",
        "fontSize": "md"
      }
    },
    {
      "id": "common-suction-tank",
      "type": "tank",
      "position": {
        "x": 100,
        "y": 250
