      "data": {
        "label": "Note",
        "title": "CHILLED WATER CIRCUIT",
        "text": "Demonstrates a closed-loop industrial chilled water cooling circuit with parallel primary pumps, check valve protection, heat exchanger cooling load, dynamic 3-way TCV mixing, and an expansion reservoir.",
        "fontSize": "md"
      }
    },
