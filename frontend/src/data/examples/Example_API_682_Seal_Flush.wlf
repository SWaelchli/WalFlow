      "data": {
        "label": "Note",
        "title": "API 682 SEAL FLUSH (PLAN 52/53)",
        "text": "Demonstrates a dual mechanical seal barrier fluid circulation loop for process pumps. Features a barrier reservoir, circulation pump, orifice flow restriction, and heat exchanger to maintain seal lubrication and dissipate frictional heat.",
        "fontSize": "md"
      }
    },
