        "x": 100,
        "y": -120
      },
      "width": 400,
      "height": 140,
      "style": {
        "width": 400,
        "height": 140
      },
      "data": {
        "label": "Note",
        "title": "PRV VS. BPR REGULATION",
        "text": "Demonstrates the fundamental difference between pressure regulation modes: a Pressure Reducing Valve (PRV) maintains constant downstream load pressure, while a Backpressure Regulator (BPR) maintains constant upstream header pressure by bypassing excess flow.",
        "fontSize": "md"
      }
    },
    {
      "id": "feed-tank",
      "type": "tank",
      "position": {
        "x": 100,
        "y": 250
      },
      "data": {
        "label": "Feed Tank",
        "level": 2.0,
        "elevation": 0.0,
        "temperature": 293.15
      }
    },
    {
      "id": "main-pump",
      "type": "centrifugal_pump",
      "position": {
        "x": 260,
        "y": 250
      },
      "data": {
        "label": "Supply Pump",
        "flow_rated_lmin": 150.0,
        "pressure_rated_bar": 8.0,
        "rise_to_shutoff_pct": 20.0
      }
    },
    {
      "id": "header-splitter",
      "type": "splitter",
