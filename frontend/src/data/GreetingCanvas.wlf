      "data": {
        "label": "Note",
        "title": "WELCOME TO WALFLOW",
        "text": "WalFlow is a web-based hydraulic process simulator for designing and modeling hydraulic flow networks.\n\n\u2022 Drag components from the sidebar onto the canvas to construct your P&ID.\n\u2022 Select components or pipes to view and edit operating parameters.\n\u2022 Click \"Run Simulation\" in the top bar to solve system pressures, flow rates, and fluid states.\n\nBelow is a simple starter circuit\u2014press Run Simulation to see it in action!",
        "fontSize": "md"
      }
    },
    {
      "id": "greeting-tank-1",
      "type": "tank",
      "position": {
        "x": 120,
        "y": 350
      },
      "data": {
        "label": "Supply Reservoir",
        "level": 3.0,
        "elevation": 0.0,
        "temperature": 293.15
      }
    },
