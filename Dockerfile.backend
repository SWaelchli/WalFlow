# Python Backend Dockerfile for WalFlow
FROM python:3.13-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy and install requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend ./backend

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/backend
ENV PORT=8000
# Largest WebSocket message uvicorn accepts, in bytes (F2-13); uvicorn reads UVICORN_* variables as its CLI options
ENV UVICORN_WS_MAX_SIZE=2097152

WORKDIR /app/backend

EXPOSE 8000

# Launch Uvicorn FastAPI server
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
