# Multi-stage Dockerfile for WalFlow Frontend
# Stage 1: Build React SPA
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files and install dependencies
COPY frontend/package*.json ./
RUN npm ci

# Copy frontend source code and build production bundle
COPY frontend/ ./
RUN npm run build

# Stage 2: Serve static bundle via Nginx
FROM nginx:alpine AS production

# Nginx configuration as a template: ${NGINX_*} variables are substituted from the environment at container start
COPY nginx.conf /etc/nginx/templates/default.conf.template
ENV NGINX_ENVSUBST_FILTER=^NGINX_
ENV NGINX_MAX_BODY_SIZE=5m

# Copy built static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
