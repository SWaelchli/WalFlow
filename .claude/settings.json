{
  "permissions": {
    "allow": [
      "Bash(python -m pytest)",
      "Bash(python -m pytest *)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "mcp__claude-in-chrome__find"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/scope-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking subagent write scope"
          }
        ]
      }
    ]
  }
}
